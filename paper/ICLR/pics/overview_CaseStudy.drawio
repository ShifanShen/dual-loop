        <mxCell id="PeL1hECyrzDedPoqC2eK-118" value="&lt;div style=&quot;font-size: 30px;&quot;&gt;s⁽⁰⁾&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=1;points=[];autosize=0;whiteSpace=wrap;overflow=visible;fontSize=30;fontFamily=Times New Roman;fontColor=#111;fontStyle=2;spacing=0;" vertex="1" parent="1">
