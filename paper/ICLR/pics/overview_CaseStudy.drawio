        <mxCell id="PeL1hECyrzDedPoqC2eK-119" value="&lt;div style=&quot;font-size: 24px;&quot;&gt;Given a binary string s, partition it into the minimum number of beautiful substrings. Each substring must have no leading zero and must represent a power of 5. Return −1 if no valid partition exists.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=1;points=[];autosize=0;whiteSpace=wrap;overflow=visible;fontSize=24;fontFamily=Times New Roman;fontColor=#111;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="48" y="139.76" width="323" height="208.24" as="geometry" />
        </mxCell>
        <mxCell id="PeL1hECyrzDedPoqC2eK-120" value="&lt;div style=&quot;font-size: 21px;&quot;&gt;&lt;ul style=&quot;font-size: 21px;&quot;&gt;&lt;li style=&quot;font-size: 21px;&quot;&gt;partition the binary string&lt;/li&gt;&lt;li style=&quot;font-size: 21px;&quot;&gt;minimize the number of substrings&lt;/li&gt;&lt;li style=&quot;font-size: 21px;&quot;&gt;each substring represents a&lt;/li&gt;&lt;li style=&quot;font-size: 21px;&quot;&gt;power of 5&lt;/li&gt;&lt;li style=&quot;font-size: 21px;&quot;&gt;return −1 if impossible&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=1;points=[];autosize=0;whiteSpace=wrap;overflow=visible;fontSize=21;fontFamily=Times New Roman;fontColor=#111;fontStyle=0;spacing=0;" vertex="1" parent="1">
